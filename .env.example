# Copy this file to .env and fill in real values. Never commit the real .env file.

# ---- Database ----
DB_HOST=localhost
# 5433, not the Postgres default 5432: on some machines a native/other Postgres
# install already owns 5432, and Docker's port mapping can silently lose that
# collision (see docs/troubleshooting.md). Change freely if 5433 is also taken.
DB_PORT=5433
DB_NAME=collabflow
DB_USER=collabflow
DB_PASSWORD=change-me

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# ---- Auth / JWT ----
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-random-base64-secret-at-least-64-bytes-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- App ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# ---- Rate limiting ----
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_CAPACITY=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
